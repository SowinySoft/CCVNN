name: "ccvnn"
backend: "openvino"
max_batch_size: 32

input [
  {
    name: "input_rgba"
    data_type: TYPE_FP32
    dims: [ 4, 64, 64 ]
  }
]
output [
  {
    name: "output_logits"
    data_type: TYPE_FP32
    dims: [ 10 ]
  }
]
instance_group [
  {
    count: 2
    kind: KIND_CPU
  }
]
dynamic_batching {
  preferred_batch_size: [ 8, 16, 32 ]
  max_queue_delay_microseconds: 5000
}