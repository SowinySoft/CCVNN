name: "ccvnn_v21_int8"
backend: "openvino"
max_batch_size: 0

input [
  {
    name: "84"
    data_type: TYPE_FP32
    dims: [ -1, 4, 64, 64 ]
  }
]

output [
  {
    name: "output_logits"
    data_type: TYPE_FP32
    dims: [ -1, 10 ]
  }
]

instance_group [
  {
    count: 2
    kind: KIND_CPU
  }
]

parameters {
  key: "INFERENCE_NUM_THREADS"
  value: { string_value: "4" }
}
parameters {
  key: "CPU_THROUGHPUT_STREAMS"
  value: { string_value: "2" }
}
parameters {
  key: "ENABLE_CPU_PINNING"
  value: { string_value: "NO" }
}
parameters {
  key: "PERFORMANCE_HINT"
  value: { string_value: "THROUGHPUT" }
}

#parameters: {
#  key: "intra_op_thread_count"
#  value: { string_value: "4" }
#}

#parameters: {
#  key: "execution_mode"
#  value: { string_value: "EXECUTION_PARALLEL" }
#}


model_warmup [
  {
    name: "dynamic_warmup_sample"
    count: 1
    inputs {
      key: "84"
      value {
        data_type: TYPE_FP32
        dims: [ 1, 4, 64, 64 ]
        zero_data: true
      }
    }
  }
]