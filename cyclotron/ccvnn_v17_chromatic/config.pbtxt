name: "ccvnn_v17_chromatic"
backend: "python"
max_batch_size: 0

input [
  {
    name: "INPUT_FRAME"
    data_type: TYPE_UINT8
    dims: [ -1, -1, 3 ]
  }
]

output [
  {
    name: "TELEMETRY_JSON"
    data_type: TYPE_STRING
    dims: [ 1 ]
  },
  {
    name: "PLC_COIL_STATE"
    data_type: TYPE_INT32
    dims: [ 1 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]
