[Unit]
Description=DeepStream Dual-Mode Edge Pipeline Container
Requires=docker.service
After=docker.service nvargus-daemon.service network-online.target
Wants=network-online.target nvargus-daemon.service

[Service]
Type=notify
NotifyAccess=all
WatchdogSec=10s
WorkingDirectory=/opt/ds-dualmode
ExecStartPre=-/usr/bin/docker compose down --remove-orphans
ExecStart=/usr/bin/docker compose up --no-color
ExecStop=/usr/bin/docker compose down
Restart=always
RestartSec=5s
TimeoutStartSec=0
StandardOutput=journal
StandardError=journal

# Process & Hardware Resource Limits
KillMode=mixed
LimitCORE=infinity
LimitNOFILE=65536
LimitNPROC=65536

[Install]
WantedBy=multi-user.target