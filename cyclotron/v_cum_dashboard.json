      "title": "Anomaly Recurrence Trajectory (S_anomaly vs S_cum)",
      "type": "timeseries",
      "datasource": { "type": "influxdb", "uid": "influxdb-ccvnn" },
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "influxdb-ccvnn" },
          "query": "from(bucket: \"v_cum_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"v_cum_telemetry\")\n  |> filter(fn: (r) => r[\"_field\"] == \"v_cum_S_anomaly\" or r[\"_field\"] == \"v_cum_S_cum\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2 },
          "min": 0,
          "max": 1
        }
      }
    },
