name: "ccvnn_v17_backbone"
backend: "openvino"
max_batch_size: 0

input [
  {
    name: "v_input_17"
    data_type: TYPE_FP32
    dims: [ -1, 17 ]
  }
]

output [
  {
    name: "hazard_prob"
    data_type: TYPE_FP32
    dims: [ -1, 1 ]
  }
]

instance_group [
  {
    count: 4
    kind: KIND_CPU
  }
]

parameters: {
  key: "NUM_STREAMS"
  value: { string_value: "4" }
}
parameters: {
  key: "INFERENCE_NUM_THREADS"
  value: { string_value: "8" }
}