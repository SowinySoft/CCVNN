name: "ccvnn_v25_backbone"
backend: "openvino"
max_batch_size: 0

input [
  {
    name: "input_rgba"
    data_type: TYPE_FP32
    dims: [ -1, 4, -1, -1 ]
  }
]

output [
  {
    name: "hazard_prob"
    data_type: TYPE_FP32
    dims: [ -1, 1 ]
  }
]

instance_group [
  {
    count: 2
    kind: KIND_CPU
  }
]
