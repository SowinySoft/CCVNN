name: "ccvnn_v17_backbone"
backend: "openvino"
max_batch_size: 16

dynamic_batching {
  preferred_batch_size: [ 4, 8, 16 ]
  max_queue_delay_microseconds: 250
}

input [
  {
    name: "v_input_17"
    data_type: TYPE_FP32
    dims: [ 17 ]
  }
]

output [
  {
    name: "hazard_prob"
    data_type: TYPE_FP32
    dims: [ 1 ]
  }
]

instance_group [
  {
    count: 2
    kind: KIND_CPU
  }
]

parameters: { key: "NUM_STREAMS" value: { string_value: "1" } }
parameters: { key: "INFERENCE_NUM_THREADS" value: { string_value: "1" } }
