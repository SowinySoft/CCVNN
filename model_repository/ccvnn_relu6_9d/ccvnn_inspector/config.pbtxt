name: "ccvnn_inspector"
platform: "pytorch_libtorch"
max_batch_size: 0

input [
  {
    name: "x"
    data_type: TYPE_FP32
    dims: [ 1, 9 ]
  }
]
output [
  {
    name: "output"
    data_type: TYPE_FP32
    dims: [ 1, 2 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]
