name: "ccvnn_v17_backbone"
backend: "openvino"
max_batch_size: 0

input [
  {
    name: "input_rgba"
    data_type: TYPE_FP32
    dims: [ -1, 4, 64, 64 ]
  }
]

output [
  {
    name: "hazard_prob"
    data_type: TYPE_FP32
    dims: [ -1, 1 ]
  }
]

dynamic_batching {
  preferred_batch_size: [ 8, 16, 32 ]
  max_queue_delay_microseconds: 2000
}

instance_group [
  {
    count: 2
    kind: KIND_CPU
  }
]
