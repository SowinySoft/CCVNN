#/etc/systemd/system/ccvnn-triton.service
[Unit]
Description=CCVNN V20 Triton Inference Server
After=network.target docker.service
Wants=docker.service

[Service]
WorkingDirectory=/opt/DDVNN-HOME/CCVNN/production
ExecStart=/usr/bin/docker compose up
ExecStop=/usr/bin/docker compose down
Restart=always
User=root

[Install]
WantedBy=multi-user.target